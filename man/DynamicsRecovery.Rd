  alpha = NULL,
  beta = NULL,
  gamma = NULL,
  scaling = NULL,
  adjust_t_ = TRUE
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{t}}{Optional finite, non-negative global time vector with one value
per cell. \code{NULL} uses trajectory projection when
\code{refit_time = TRUE}.}
      \item{\code{t_}}{Transcription switch time.}
      \item{\code{alpha, beta, gamma}}{Optional kinetic
parameter updates.
\code{NULL} keeps the current value.}
      \item{\code{scaling}}{Optional scaling update.}
      \item{\code{adjust_t_}}{Logical. Whether to automatically adjust \code{t_}.
Default \code{TRUE}.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    Logical. \code{TRUE} if the proposed update was accepted.
  }
}

